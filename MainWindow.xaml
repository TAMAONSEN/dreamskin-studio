<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="DreamSkin Studio" Width="1320" Height="810" MinWidth="1080" MinHeight="730"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI"
 FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

  <!-- Smoked glass: the aurora behind stays visible but never fights the text. -->
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/>
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style x:Key="Micro" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <!-- Drawn rather than taken from the icon font, whose folder glyph differs between Windows builds. -->
  <Style x:Key="FolderIcon" TargetType="Path"><Setter Property="Data" Value="M 1.5,3 H 5.6 L 7.2,4.8 H 13.5 V 12 H 1.5 Z"/><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="StrokeThickness" Value="1.15"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style>
  <Style x:Key="Chip" TargetType="Border"><Setter Property="Background" Value="#B30C0D12"/><Setter Property="BorderBrush" Value="#26FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="10,5"/></Style>
  <Style x:Key="Halo" TargetType="Ellipse">
   <Setter Property="OpacityMask"><Setter.Value><RadialGradientBrush><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#8C000000" Offset="0.38"/><GradientStop Color="#26000000" Offset="0.72"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
  </Style>

  <!-- Secondary button. Hover and press are event-driven so they can ease in and out. Tag="on" marks a chosen segment. -->
  <Style TargetType="Button">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
     <Border x:Name="Tint" Background="White" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.955" Duration="0:0:0.07"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.955" Duration="0:0:0.07"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.4"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.4"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger>
     <Trigger Property="Tag" Value="on"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Primary: accent gradient, a soft glow beneath, and a light sweep on hover. -->
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="Padding" Value="20,10"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
     <Border x:Name="Glow" CornerRadius="12" Background="{DynamicResource AccentGradient}" Opacity="0.4" Margin="10,12,10,-5" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="18"/></Border.Effect></Border>
     <Border x:Name="Surface" CornerRadius="11" Background="{DynamicResource AccentGradient}"/>
     <Border x:Name="Shine" CornerRadius="11" IsHitTestVisible="False">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4"><LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#00FFFFFF" Offset="0.3"/><GradientStop Color="#99FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="0.7"/></LinearGradientBrush></Border.Background>
     </Border>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)" From="-1" To="1" Duration="0:0:0.75"/><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.4"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.955" Duration="0:0:0.07"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.955" Duration="0:0:0.07"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.4"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.4"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/><Setter TargetName="Glow" Property="Visibility" Value="Hidden"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="10,7"/>
  </Style>
  <!-- The chosen item is marked by the glider that slides behind these buttons. -->
  <Style x:Key="Nav" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,0,0,4"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent">
     <Border x:Name="Tint" Background="White" CornerRadius="11" Opacity="0"/>
     <ContentPresenter Margin="15,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/></Storyboard></BeginStoryboard></EventTrigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
     <Trigger Property="Tag" Value="on"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Chrome" TargetType="Button">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="10"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ChromeClose" TargetType="Button" BasedOn="{StaticResource Chrome}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5484D"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Box" Width="18" Height="18" CornerRadius="6" BorderBrush="{DynamicResource Subtle}" BorderThickness="1.5" Background="Transparent" VerticalAlignment="Center">
     <Path x:Name="Mark" Data="M 3.5,9 L 7,12.5 L 14,5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="-1.5"/>
    </Border>
    <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentGradient}"/><Setter TargetName="Box" Property="BorderThickness" Value="0"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="Slider"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="28">
   <Border Height="5" CornerRadius="2.5" Background="{DynamicResource Hover}" VerticalAlignment="Center"/>
   <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="5" CornerRadius="2.5" Background="{DynamicResource AccentGradientH}" VerticalAlignment="Center"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Width="22" Height="22" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb">
     <Grid x:Name="Knob" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
      <Ellipse Fill="{DynamicResource Accent2}" Opacity="0.55" Margin="-3"><Ellipse.Effect><BlurEffect Radius="8"/></Ellipse.Effect></Ellipse>
      <Ellipse Fill="White"/><Ellipse Margin="6" Fill="{DynamicResource AccentGradient}"/>
     </Grid>
     <ControlTemplate.Triggers>
      <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.18" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.18" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger>
      <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22"/><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></EventTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
   </Track></Grid></ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="28" Margin="2,0"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="2" Background="White" Opacity="0.22"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid Background="Transparent">
     <Border x:Name="Tint" Background="White" CornerRadius="12" Opacity="0"/>
     <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="8"><ContentPresenter/></Border>
     <Border x:Name="Bar" Width="3" Height="20" CornerRadius="1.5" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
     <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/></Storyboard></BeginStoryboard></EventTrigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Line}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1"><ContentPresenter/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,8,34,8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Background="{DynamicResource Solid}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="0,4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
     </Border>
    </Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton x:Name="Header" Cursor="Hand" Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><StackPanel Orientation="Horizontal" Background="Transparent"><TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,1,8,0" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"/></StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Paper}">
 <Grid x:Name="RootGrid" ClipToBounds="True">

  <!-- Ambient light. Each halo is cached at low resolution; moving it only shifts a texture. -->
  <Canvas x:Name="AuroraLayer" IsHitTestVisible="False">
   <Grid x:Name="Blob1" Width="1080" Height="1080" Opacity="0.52"><Grid.CacheMode><BitmapCache RenderAtScale="0.2"/></Grid.CacheMode><Ellipse Style="{StaticResource Halo}" Fill="{DynamicResource Glow1}"/></Grid>
   <Grid x:Name="Blob2" Width="1180" Height="1180" Opacity="0.44"><Grid.CacheMode><BitmapCache RenderAtScale="0.2"/></Grid.CacheMode><Ellipse Style="{StaticResource Halo}" Fill="{DynamicResource Glow2}"/></Grid>
   <Grid x:Name="Blob3" Width="860" Height="860" Opacity="0.36"><Grid.CacheMode><BitmapCache RenderAtScale="0.2"/></Grid.CacheMode><Ellipse Style="{StaticResource Halo}" Fill="{DynamicResource Glow3}"/></Grid>
   <Grid x:Name="Blob4" Width="900" Height="900" Opacity="0.30"><Grid.CacheMode><BitmapCache RenderAtScale="0.2"/></Grid.CacheMode><Ellipse Style="{StaticResource Halo}" Fill="{DynamicResource Glow1}"/></Grid>
   <Grid x:Name="Spotlight" Width="620" Height="620" Opacity="0"><Grid.CacheMode><BitmapCache RenderAtScale="0.2"/></Grid.CacheMode><Ellipse Style="{StaticResource Halo}" Fill="{DynamicResource Accent}"/></Grid>
  </Canvas>
  <Rectangle x:Name="Grain" IsHitTestVisible="False" Opacity="0.035"/>

  <Grid x:Name="ContentRoot">
   <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- Sidebar -->
   <Border x:Name="Sidebar" Tag="reveal" Margin="10,10,0,10" Padding="12,14,12,12" CornerRadius="18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="6,2,0,24">
      <Image x:Name="StudioMark" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="DreamSkin" FontSize="16" FontWeight="Bold" TextWrapping="NoWrap"/>
       <TextBlock Text="Wallpaper Studio" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap"/>
      </StackPanel>
     </StackPanel>
     <StackPanel Grid.Row="1">
      <Grid>
       <Border x:Name="NavGlider" Height="42" VerticalAlignment="Top" CornerRadius="11" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Border Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left" Margin="-1,0,0,0"/>
       </Border>
       <StackPanel x:Name="NavItems">
        <Button x:Name="NavHome" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,13,0"/><TextBlock Text="幕布" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="NavLibrary" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,13,0"/><TextBlock Text="收藏" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="NavSettings" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,13,0"/><TextBlock Text="工作室" VerticalAlignment="Center"/></StackPanel></Button>
       </StackPanel>
      </Grid>
      <Border Height="1" Background="{DynamicResource Line}" Margin="6,12,6,16"/>
      <Button x:Name="AddMediaButton" HorizontalContentAlignment="Left" Padding="14,10" ToolTip="导入图片或视频作为背景（Ctrl+O）"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,11,0"/><TextBlock Text="添加素材"/></StackPanel></Button>
     </StackPanel>
     <Border Grid.Row="3" Background="{DynamicResource Field}" CornerRadius="12" Padding="14,12">
      <StackPanel>
       <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource Subtle}"/>
        <TextBlock x:Name="ConnectionLabel" Text="正在读取状态…" FontSize="13" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="EngineLabel" Text="DreamSkin 引擎" Style="{StaticResource Micro}" Margin="17,4,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <!-- Main column -->
   <Grid Grid.Column="1" Margin="14,0,10,0">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,-4,0">
     <Button x:Name="MinimizeButton" Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="最小化"/>
     <Button x:Name="MaximizeButton" Style="{StaticResource Chrome}" Content="&#xE922;" ToolTip="最大化 / 还原"/>
     <Button x:Name="CloseButton" Style="{StaticResource ChromeClose}" Content="&#xE8BB;" ToolTip="关闭管理器，保留当前背景"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="6,0,6,18">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="PageHeading" VerticalAlignment="Bottom">
      <TextBlock x:Name="PageEyebrow" Text="CANVAS" Style="{StaticResource Eyebrow}"/>
      <TextBlock x:Name="PageTitle" Text="当前背景" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TitleGradient}" Margin="0,2,0,0" TextWrapping="NoWrap" HorizontalAlignment="Left"/>
      <TextBlock x:Name="PageSubtitle" Text="一张画面，一点个性。把工作空间变成你的。" Style="{StaticResource Small}" FontSize="14" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
      <Button x:Name="RefreshButton" Style="{StaticResource Link}" Margin="0,0,10,0" ToolTip="刷新状态（F5）"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="刷新"/></StackPanel></Button>
      <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="打开主题版 Codex"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="6,0,6,0">
     <!-- Home -->
     <Grid x:Name="HomePage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="312"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border x:Name="HomeStage" Tag="reveal" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20"><Grid>
        <!-- The preview lives on a plane in 3D so it can lean towards the pointer. -->
        <Viewport3D x:Name="ArtworkFrame" IsHitTestVisible="False">
         <Viewport3D.Camera><PerspectiveCamera Position="0,0,3.6" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="35" NearPlaneDistance="0.1" FarPlaneDistance="60"/></Viewport3D.Camera>
         <ModelVisual3D><ModelVisual3D.Content><AmbientLight Color="White"/></ModelVisual3D.Content></ModelVisual3D>
         <Viewport2DVisual3D x:Name="ArtworkPlane">
          <Viewport2DVisual3D.Transform><Transform3DGroup>
           <RotateTransform3D><RotateTransform3D.Rotation><AxisAngleRotation3D Axis="1,0,0" Angle="0"/></RotateTransform3D.Rotation></RotateTransform3D>
           <RotateTransform3D><RotateTransform3D.Rotation><AxisAngleRotation3D Axis="0,1,0" Angle="0"/></RotateTransform3D.Rotation></RotateTransform3D>
          </Transform3DGroup></Viewport2DVisual3D.Transform>
          <Viewport2DVisual3D.Geometry><MeshGeometry3D Positions="-1,0.562,0 -1,-0.562,0 1,-0.562,0 1,0.562,0" TextureCoordinates="0,0 0,1 1,1 1,0" TriangleIndices="0 1 2 0 2 3"/></Viewport2DVisual3D.Geometry>
          <Viewport2DVisual3D.Material><DiffuseMaterial Viewport2DVisual3D.IsVisualHostMaterial="True" Brush="White"/></Viewport2DVisual3D.Material>
          <Viewport2DVisual3D.Visual>
           <Border x:Name="ArtworkViewport" Background="#0A0B0E" Width="1000" Height="562"><Grid>
            <Image x:Name="ArtworkImage" Stretch="Uniform"/><MediaElement x:Name="ArtworkVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" IsMuted="True" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyPreview" Text="把你的第一张画面放在这里。" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#C8CCD6" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="30"/>
            <Border x:Name="PreviewShade" Background="#101B25" Opacity="0.25" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="ArtworkGlare" IsHitTestVisible="False" Opacity="0">
             <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6"><GradientStop Color="#00FFFFFF" Offset="0.3"/><GradientStop Color="#3DFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="0.7"/></LinearGradientBrush></Border.Background>
            </Border>
           </Grid></Border>
          </Viewport2DVisual3D.Visual>
         </Viewport2DVisual3D>
        </Viewport3D>
        <Grid Margin="16,14" VerticalAlignment="Top">
         <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Grid Width="6" Height="6" Margin="1,0,8,0" VerticalAlignment="Center"><Ellipse x:Name="LivePulse" Fill="{DynamicResource Accent}" Opacity="0"/><Ellipse Fill="{DynamicResource Accent}"/></Grid><TextBlock Text="实时预览" Foreground="White" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border>
         <Border x:Name="MediaBadge" Style="{StaticResource Chip}" HorizontalAlignment="Right"><TextBlock x:Name="MediaTypeLabel" Text="LOADING" Foreground="White" FontSize="12" FontWeight="SemiBold"/></Border>
        </Grid>
        <Grid Margin="16,12" VerticalAlignment="Bottom">
         <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="PreviewNote" Text="原始画面 · 完整比例" Foreground="White" FontSize="12"/></Border>
         <Button x:Name="PreviewPlayButton" Content="暂停预览" Padding="12,5" FontSize="12" HorizontalAlignment="Right" Background="#B30C0D12" BorderBrush="#26FFFFFF" Foreground="White" Visibility="Collapsed" ToolTip="仅暂停管理器中的视频预览"/>
        </Grid>
        <Border x:Name="StageFlow" CornerRadius="19" BorderThickness="1.5" IsHitTestVisible="False"/>
       </Grid></Border>
       <Grid x:Name="HomeInfo" Tag="rise" Grid.Row="1" Margin="4,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
         <TextBlock x:Name="ActiveThemeName" Text="正在读取当前主题" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
         <TextBlock x:Name="MediaFileName" Text="—" Style="{StaticResource Micro}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="ShowLibraryButton" Grid.Column="1" Style="{StaticResource Link}" VerticalAlignment="Center" ToolTip="浏览收藏"><StackPanel Orientation="Horizontal"><TextBlock Text="浏览收藏"/><TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="11" Margin="7,1,0,0"/></StackPanel></Button>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
         <Button x:Name="ChangeMediaButton" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="更换背景"/></StackPanel></Button>
         <Button x:Name="SaveThemeButton" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="保存为主题"/></StackPanel></Button>
         <Button x:Name="PauseSkinButton" Content="暂停 Codex 背景"/>
        </StackPanel>
       </Grid>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="背景透出度" Style="{StaticResource CardTitle}"/>
         <Grid Margin="0,2,0,2"><TextBlock x:Name="RevealValue" Text="75%" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource AccentGradientH}" TextWrapping="NoWrap" HorizontalAlignment="Left"/><TextBlock Text="数值越大，&#10;背景越明显" Style="{StaticResource Small}" FontSize="12" LineHeight="17" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
         <Slider x:Name="RevealSlider" Minimum="0" Maximum="100" Value="75" TickFrequency="5" IsSnapToTickEnabled="False" ToolTip="数值越大，背景越明显" Margin="0,0,0,12"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Reveal60" Content="60%" Padding="0,7" Margin="0,0,6,0"/><Button x:Name="Reveal75" Grid.Column="1" Content="75%" Padding="0,7" Margin="3,0,3,0"/><Button x:Name="Reveal90" Grid.Column="2" Content="90%" Padding="0,7" Margin="6,0,0,0"/></Grid>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
         <TextBlock Text="预览模式" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
         <Border Background="{DynamicResource Field}" CornerRadius="12" Padding="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="PreviewOriginalButton" Content="原始画面" Padding="0,7" BorderThickness="0" Background="Transparent"/><Button x:Name="PreviewEffectButton" Grid.Column="1" Content="应用效果" Padding="0,7" BorderThickness="0" Background="Transparent"/></Grid></Border>
         <CheckBox x:Name="SimulateOpacity" Visibility="Collapsed"/>
         <Button x:Name="ColorsButton" Margin="0,12,0,0" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" Margin="0,0,9,0"/><TextBlock Text="自选配色"/></StackPanel></Button>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
         <TextBlock Text="素材信息" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
         <TextBlock x:Name="MediaDetails" Text="正在读取媒体…" Style="{StaticResource Small}" FontSize="13" LineHeight="22"/>
         <TextBlock x:Name="ActivityHint" Text="用「打开主题版 Codex」回到壁纸窗口。背景显示异常时，在「工作室」点「重新应用背景」。" Style="{StaticResource Small}" FontSize="12" LineHeight="18" Margin="0,12,0,0" Foreground="{DynamicResource Subtle}"/>
        </StackPanel>
       </Border>
      </StackPanel></ScrollViewer>
     </Grid>

     <!-- Library -->
     <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="348"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14,16,10,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="4,0,4,0"><TextBlock x:Name="LibraryCount" Text="已保存主题" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ImportZipButton" Style="{StaticResource Link}" HorizontalAlignment="Right" Padding="8,5" ToolTip="导入 DreamSkin 主题 ZIP"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="导入 ZIP"/></StackPanel></Button></Grid>
       <Grid Grid.Row="1" Margin="4,12,4,12"><TextBox x:Name="SearchBox" ToolTip="搜索主题名称" Padding="34,8,34,8"/><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Subtle}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="搜索主题…" Foreground="{DynamicResource Subtle}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Button x:Name="ClearSearchButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource Link}" HorizontalAlignment="Right" Padding="10,6" Margin="0,0,3,0" ToolTip="清除搜索" Visibility="Collapsed"/></Grid>
       <ListBox x:Name="ThemeList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource Ink}"/>
       <Grid Grid.Row="3" Margin="4,10,4,0"><TextBlock Text="选中后预览，应用后才切换背景。" Style="{StaticResource Small}" FontSize="12" VerticalAlignment="Center" Margin="0,0,90,0"/><Button x:Name="OpenLibraryButton" Style="{StaticResource Link}" Padding="8,5" HorizontalAlignment="Right" ToolTip="打开主题文件夹"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource FolderIcon}" Margin="0,0,7,0"/><TextBlock Text="文件夹"/></StackPanel></Button></Grid>
      </Grid></Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border x:Name="LibraryStage" Tag="reveal" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20"><Grid>
        <Viewbox x:Name="LibraryFrame" Stretch="Uniform" Margin="28,52,28,36">
         <Border x:Name="LibraryViewport" Background="#0A0B0E" Width="1000" Height="562"><Grid>
          <Image x:Name="LibraryImage" Stretch="Uniform"/><MediaElement x:Name="LibraryVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" IsMuted="True" Visibility="Collapsed"/>
          <TextBlock x:Name="LibraryEmpty" Text="挑一张，让它成为今天的风景。" Foreground="#C8CCD6" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="30"/>
         </Grid></Border>
        </Viewbox>
        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14"><TextBlock Text="收藏预览" Foreground="White" FontSize="12" FontWeight="SemiBold"/></Border>
       </Grid></Border>
       <Grid x:Name="LibraryInfo" Tag="rise" Grid.Row="1" Margin="4,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
         <TextBlock x:Name="SelectedThemeName" Text="尚未选择主题" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
         <TextBlock x:Name="SelectedThemeInfo" Text="支持图片与视频主题" Style="{StaticResource Micro}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <Button x:Name="OpenSelectedButton" Style="{StaticResource Link}" IsEnabled="False" Margin="0,0,4,0" ToolTip="在资源管理器中查看"><Path Style="{StaticResource FolderIcon}"/></Button>
         <Button x:Name="RenameSelectedButton" Content="重命名" IsEnabled="False" Margin="0,0,8,0"/>
         <Button x:Name="RecycleSelectedButton" Content="移到回收站" IsEnabled="False" Margin="0,0,10,0" ToolTipService.ShowOnDisabled="True"/>
         <Button x:Name="ApplySelectedButton" Style="{StaticResource Primary}" Content="应用这张主题" IsEnabled="False" Padding="18,9"/>
        </StackPanel>
       </Grid>
      </Grid>
     </Grid>

     <!-- Settings -->
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,0,8,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="配色" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="界面的光与强调色默认取自当前壁纸，也可以自己选一个颜色。Codex 主题的配色单独设置。" Style="{StaticResource Small}" Margin="0,4,0,14"/>
        <Button x:Name="SettingsColorsButton" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" Margin="0,0,9,0"/><TextBlock Text="打开配色设置"/></StackPanel></Button>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
        <TextBlock Text="启动" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="选择管理器的启动方式。不会自动重启 Codex。" Style="{StaticResource Small}" Margin="0,4,0,14"/>
        <CheckBox x:Name="AutoStartCheck" Content="登录 Windows 时打开 DreamSkin"/>
        <Button x:Name="OpenEngineFolderButton" Style="{StaticResource Link}" Padding="0,6" HorizontalAlignment="Left" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource FolderIcon}" Margin="0,0,8,0"/><TextBlock Text="打开引擎目录"/></StackPanel></Button>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
        <TextBlock Text="恢复官方外观" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="一键恢复 Codex 官方外观，保留你的主题收藏和媒体文件。" Style="{StaticResource Small}" Margin="0,4,0,14"/>
        <Button x:Name="RestoreButton" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" Margin="0,0,9,0"/><TextBlock Text="恢复官方外观"/></StackPanel></Button>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,14,0"/><StackPanel><TextBlock Text="完全在本机运行" FontWeight="SemiBold"/><TextBlock Text="素材留在本机 · 无需订阅 · 不自动重启 Codex" Style="{StaticResource Small}" Margin="0,2,0,0"/></StackPanel></StackPanel></Border>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <Border Style="{StaticResource Card}"><StackPanel x:Name="WallpaperLinkHost"/></Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
        <Grid><TextBlock Text="诊断" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/><Button x:Name="DiagnoseButton" Content="运行检查" HorizontalAlignment="Right" Padding="12,6"/></Grid>
        <TextBlock Text="检查文件与连接状态，结果可以直接复制。" Style="{StaticResource Small}" Margin="0,4,0,12"/>
        <TextBox x:Name="DiagnosticsText" Height="200" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="点击「运行检查」查看结果。"/>
        <Expander Header="引擎日志（可能包含历史记录）" FontSize="13" Margin="0,12,0,0"><TextBox x:Name="HistoryLogText" IsReadOnly="True" Height="180" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Expander>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
        <Grid Margin="0,0,0,12"><TextBlock Text="操作记录" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/><Button x:Name="OpenLogsButton" Style="{StaticResource Link}" Padding="8,5" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource FolderIcon}" Margin="0,0,7,0"/><TextBlock Text="日志文件夹"/></StackPanel></Button></Grid>
        <TextBox x:Name="ActivityLog" IsReadOnly="True" Height="120" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
       </StackPanel></Border>
      </StackPanel>
     </Grid></ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Grid Grid.Row="3" Margin="10,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ProgressBar x:Name="BusyProgress" Width="40" Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource Hover}" BorderThickness="0" Visibility="Collapsed" Margin="0,0,12,0"/>
     <TextBlock x:Name="StatusText" Grid.Column="1" Text="正在连接主题引擎…" Style="{StaticResource Micro}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Column="2" Text="DreamSkin Studio · 10" Style="{StaticResource Micro}" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
 </Border>
</Window>
